{
  "name": "@accelerate-data/promptfoo-eval-harness",
  "version": "1.8.0",
  "description": "Promptfoo + OpenCode eval harness for agent behavior. Owns model/tier policy, provider wiring, package discovery, state export, and artifact guards. Consumers own eval YAML, prompts, fixtures, and assertions.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accelerate-data/promptfoo-eval-harness.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ad-evals": "bin/ad-evals.js",
    "eval-harness-init": "bin/eval-harness-init.sh"
  },
  "main": "scripts/framework/index.js",
  "files": [
    "bin/",
    "config/",
    "scripts/",
    "templates/",
    "examples/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test scripts/*.test.js scripts/framework/*.test.js scripts/framework/providers/**/*.test.js scripts/framework/providers/**/*.test.mjs",
    "lint:md": "markdownlint '**/*.md' --ignore-path .markdownlintignore",
    "bench:spawn-cost": "node bench/spawn-cost.js",
    "bench:throughput": "node bench/parallel-throughput/driver.js",
    "bench": "npm run bench:spawn-cost && npm run bench:throughput"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.17.13",
    "@openai/codex": "0.142.4",
    "@openai/codex-sdk": "0.142.5",
    "js-yaml": "^5.2.0",
    "p-limit": "^3.1.0",
    "promptfoo": "0.121.19",
    "smol-toml": "^1.6.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.0"
  },
  "overrides": {
    "@anthropic-ai/sdk": ">=0.91.1",
    "uuid": "^14.0.0"
  },
  "keywords": [
    "promptfoo",
    "opencode",
    "eval",
    "llm",
    "agent",
    "harness"
  ]
}
