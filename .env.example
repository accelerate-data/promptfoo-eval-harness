# Optional. Anthropic API key for live model evaluation through promptfoo.
ANTHROPIC_API_KEY=

# Optional. OpenAI API key if your suite invokes OpenAI providers.
OPENAI_API_KEY=

# Optional. Override the default eval timeout (ms). Default: 900000 (15 min).
PROMPTFOO_EVAL_TIMEOUT_MS=

# Optional. Override the absolute path the harness uses as eval root. The CLI
# normally sets this to <git-toplevel>/tests/evals automatically. Override only
# when running the framework outside the canonical layout.
AD_EVALS_ROOT=
