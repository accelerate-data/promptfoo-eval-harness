{
  "description": "opencode-sdk-mock-multi-turn — single + multi-turn opencode_sdk scenarios using the mock SDK (no live key needed).",
  "providers": [
    {
      "id": "file://../../../../scripts/framework/_node_bridge.js",
      "label": "opencode-sdk/opencode-mock",
      "config": {
        "provider_kind": "opencode_sdk",
        "provider_label": "opencode-sdk/opencode-mock",
        "model": "anthropic/claude-sonnet-4-6",
        "extra": {
          "opencode_agent": "build"
        }
      }
    }
  ],
  "tests": [
    {
      "description": "[single-turn] greeting yields Hi there!",
      "vars": {
        "turns": "[\"hello\"]"
      },
      "assert": [
        {
          "type": "javascript",
          "value": "output && output.length > 0"
        },
        {
          "type": "javascript",
          "value": "output.includes('Hi there!')"
        }
      ]
    },
    {
      "description": "[multi-turn] 3-turn session must recall the number remembered in turn 1",
      "vars": {
        "turns": "[\"Please remember 42 for me.\", \"Thanks, log that for later.\", \"what number was it?\"]"
      },
      "assert": [
        {
          "type": "javascript",
          "value": "output && output.length > 0"
        },
        {
          "type": "javascript",
          "value": "(() => { const parts = output.split('\\n---\\n'); return parts.length === 3; })()"
        },
        {
          "type": "javascript",
          "value": "output.split('\\n---\\n')[0].includes(\"I'll remember 42\")"
        },
        {
          "type": "javascript",
          "value": "output.split('\\n---\\n')[2].includes('42')"
        }
      ]
    }
  ]
}
